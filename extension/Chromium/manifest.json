{
  "manifest_version": 3,
  "name": "Scr33nX",
  "version": "2.0",
  "description": "Add Chaturbate / Stripchat / CamSoda models to Scr33nX with one click.",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "alarms", "contextMenus"],
  "host_permissions": [
    "http://localhost:5200/*",
    "http://127.0.0.1/*",
    "*://*.chaturbate.com/*",
    "*://*.stripchat.com/*",
    "*://*.camsoda.com/*",
    "*://*.myfreecams.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "*://*.chaturbate.com/*",
        "*://*.stripchat.com/*",
        "*://*.camsoda.com/*",
        "*://*.myfreecams.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["player.html"],
      "matches": [
        "*://*.chaturbate.com/*",
        "*://*.stripchat.com/*",
        "*://*.camsoda.com/*",
        "*://*.myfreecams.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/devil16.png",
    "32": "icons/devil32.png",
    "48": "icons/devil48.png",
    "128": "icons/devil128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scr33nX",
    "default_icon": {
      "16": "icons/devil16.png",
      "32": "icons/devil32.png",
      "48": "icons/devil48.png",
      "128": "icons/devil128.png"
    }
  }
}
